---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { DOCS_URL, GITHUB_ORG, repos } from '../config';

import githubIcon from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import arrowIcon from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';

import corridor from '../assets/photos/hostel-corridor.jpg';
import qrPhone from '../assets/photos/qr-pass-phone.jpg';
import breadboard from '../assets/photos/esp32-breadboard.jpg';
import campus from '../assets/photos/campus-path.jpg';
import staffLogin from '../assets/screens/web-staff-login.png';
import studentLogin from '../assets/screens/web-login-mobile.png';

const forStudents = [
	'Their QR pass, always on their phone',
	'Late-access requests and Going Home',
	'Complaints, with photos',
	'Notices and their own movement history',
];

const forStaff = [
	'Who is in and who is out, live',
	'Approve late returns, see every incident',
	'Complaints from report to resolved',
	'Rooms, beds, invitations and reports',
];
---

<Base
	title="HostelHive, open-source hostel management"
	description="QR passes at the gate, live presence for wardens, and one place for late-access requests, complaints and rooms. Open source."
>
	<header class="nav wrap">
		<a href="/" aria-label="HostelHive home"><Logo /></a>
		<nav aria-label="Main">
			<a href="#gate">At the gate</a>
			<a href="#app">The app</a>
			<a href="#hardware">Hardware</a>
			<a href="#open-source">Open source</a>
		</nav>
		<a class="btn btn-primary nav-docs" href={DOCS_URL}>Read the docs</a>
	</header>

	<main>
		<section class="hero wrap">
			<div class="hero-copy">
				<h1>The signing book, <span class="accent">replaced.</span></h1>
				<p class="lede">
					QR passes at the gate, live presence for wardens, and one place for late-access requests, complaints and rooms.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href={`${DOCS_URL}/getting-started/quick-start/`}>Read the docs <Fragment set:html={arrowIcon} /></a>
					<a class="btn btn-secondary" href={GITHUB_ORG}><Fragment set:html={githubIcon} /> GitHub</a>
				</div>
			</div>
			<figure class="hero-photo">
				<Image
					src={corridor}
					alt="An open-air hostel corridor in afternoon light, with laundry drying outside the rooms"
					widths={[480, 760, 1100]}
					sizes="(max-width: 860px) 100vw, 42vw"
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
		</section>

		<section id="gate" class="gate wrap">
			<Image
				src={qrPhone}
				alt="A hand holding up a phone that shows a QR code"
				widths={[480, 900]}
				sizes="(max-width: 860px) 100vw, 50vw"
				class="gate-photo"
			/>
			<div class="gate-copy">
				<h2>A pass on every phone. A scanner at every gate.</h2>
				<p>
					Students carry one QR pass. It holds a random ID and nothing personal. The scanner at the gate asks the server
					before it opens, and the warden's screen updates within seconds.
				</p>
				<ol class="steps">
					<li>
						<h3>Show the pass</h3>
						<p>From the app, the web portal, or a printed card.</p>
					</li>
					<li>
						<h3>The gate checks with the server</h3>
						<p>Open hours, approvals and repeat scans are decided there, not on the box.</p>
					</li>
					<li>
						<h3>Staff see it live</h3>
						<p>Headcounts update, and anything after hours shows up as an incident.</p>
					</li>
				</ol>
			</div>
		</section>

		<section id="app" class="app">
			<div class="wrap">
				<h2 class="app-title">One app for the people who live there, and the people who run it.</h2>
				<div class="app-grid">
					<figure class="shot shot-desktop">
						<Image
							src={staffLogin}
							alt="The HostelHive staff sign-in page"
							widths={[640, 1100, 1600]}
							sizes="(max-width: 860px) 100vw, 62vw"
						/>
						<figcaption>Staff sign-in on the live web app.</figcaption>
					</figure>
					<figure class="shot shot-phone">
						<Image src={studentLogin} alt="The HostelHive student sign-in page on a phone" widths={[320, 520]} sizes="260px" />
						<figcaption>The student portal on a phone.</figcaption>
					</figure>
				</div>
				<div class="audiences">
					<div>
						<h3>Students</h3>
						<ul>{forStudents.map((item) => <li>{item}</li>)}</ul>
					</div>
					<div>
						<h3>Wardens and admins</h3>
						<ul>{forStaff.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>
			</div>
		</section>

		<section id="hardware" class="hardware wrap">
			<div class="hardware-copy">
				<h2>No answer from the server? The gate stays shut.</h2>
				<p>
					The scanner is an ESP32 with a small screen, two lights, a buzzer and a relay for the lock. It never decides on its
					own. No network, a timeout or an error all leave the gate locked, and staff use a logged override button instead.
				</p>
				<p>
					Every gate has its own credential, which an admin can replace at any time. It talks to the server over TLS
					pinned to one root certificate.
				</p>
				<a class="text-link" href={`${DOCS_URL}/hardware/overview/`}>How the gates work <Fragment set:html={arrowIcon} /></a>
			</div>
			<Image
				src={breadboard}
				alt="An ESP32 prototype on a breadboard with jumper wires"
				widths={[480, 900, 1300]}
				sizes="(max-width: 860px) 100vw, 55vw"
				class="hardware-photo"
			/>
		</section>

		<section class="numbers wrap" aria-label="Measured results">
			<div>
				<strong>100</strong>
				<p>Lighthouse performance score on the student sign-in page</p>
			</div>
			<div>
				<strong>107</strong>
				<p>API operations, each documented in the built-in API explorer</p>
			</div>
			<div>
				<strong>0</strong>
				<p>Passwords stored by HostelHive. Sign-in is handled by Firebase.</p>
			</div>
		</section>

		<section id="open-source" class="oss">
			<Image
				src={campus}
				alt="A tree-lined brick path on a university campus"
				widths={[800, 1400, 1800]}
				sizes="100vw"
				class="oss-photo"
			/>
			<div class="wrap oss-body">
				<div class="oss-intro">
					<h2>Run it for your hostel.</h2>
					<p>
						HostelHive is open source and split into four parts you can deploy on their own. The docs walk through setup,
						deployment and building the gate scanners.
					</p>
					<a class="btn btn-primary" href={`${DOCS_URL}/getting-started/quick-start/`}>Read the docs <Fragment set:html={arrowIcon} /></a>
				</div>
				<ul class="repos">
					{
						repos.map((r) => (
							<li>
								<a href={`${GITHUB_ORG}/${r.name}`}>
									<code>{r.name}</code>
									<span>{r.summary}</span>
									<small>{r.stack}</small>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>

	<footer class="footer wrap">
		<div class="footer-top">
			<Logo />
			<p>Started as a SENG 34213 project at the University of Kelaniya.</p>
			<nav aria-label="Footer">
				<a href={DOCS_URL}>Docs</a>
				<a href={GITHUB_ORG}>GitHub</a>
			</nav>
		</div>
		<p class="credits">
			Photos from Unsplash by
			<a href="https://unsplash.com/photos/a-long-hallway-with-clothes-hanging-on-the-walls--TM2ySQ8tuc">Thorium</a>,
			<a href="https://unsplash.com/photos/black-android-smartphone-displaying-qr-code-Q6uqw_Hjye8">Markus Winkler</a>,
			<a href="https://unsplash.com/photos/a-white-board-with-a-bunch-of-wires-attached-to-it-r98pDCvbcfM">Vishnu Mohanan</a> and
			<a href="https://unsplash.com/photos/a-woman-walking-down-a-brick-sidewalk-next-to-tall-trees-VWOCv9DxKWA">Zoshua Colah</a>.
		</p>
	</footer>
</Base>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 4.25rem;
	}

	.nav > a:first-child {
		text-decoration: none;
	}

	.nav nav {
		display: flex;
		gap: 1.75rem;
		font-size: 0.925rem;
	}

	.nav nav a {
		color: var(--muted);
		text-decoration: none;
	}

	.nav nav a:hover {
		color: var(--ink);
	}

	.nav-docs {
		padding: 0.55rem 1rem;
	}

	/* Hero: copy left, tall photo right */
	.hero {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 6rem);
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.5rem);
		font-weight: 800;
		line-height: 1.05;
	}

	.lede {
		margin-top: 1.5rem;
		max-width: 30rem;
		font-size: 1.2rem;
		color: var(--ink-soft);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.hero-photo {
		margin: 0;
	}

	.hero-photo img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: var(--radius);
	}

	/* At the gate: photo bleeds left, copy and steps right */
	.gate {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding-block: clamp(3rem, 7vw, 6rem);
		border-top: 1px solid var(--line);
	}

	.gate-photo {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
		border-radius: var(--radius);
	}

	h2 {
		font-size: clamp(1.9rem, 3.6vw, 2.75rem);
		font-weight: 750;
	}

	.gate-copy > p {
		margin-top: 1.25rem;
		color: var(--ink-soft);
		max-width: 34rem;
	}

	.steps {
		display: grid;
		gap: 1.25rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}

	.steps li {
		position: relative;
		padding-left: 2.75rem;
		counter-increment: step;
	}

	.steps li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 0.05rem;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: var(--surface);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.steps h3 {
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.steps p {
		margin-top: 0.2rem;
		font-size: 0.975rem;
		color: var(--muted);
	}

	/* The app: real screenshots on a tinted band */
	.app {
		background: var(--tint);
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}

	.app-title {
		max-width: 44rem;
	}

	.app-grid {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: end;
		margin-top: 3rem;
	}

	.shot {
		margin: 0;
	}

	.shot img {
		border-radius: 10px;
		border: 1px solid var(--line);
		box-shadow: 0 18px 40px -24px color-mix(in srgb, #181037 45%, transparent);
	}

	.shot-phone img {
		width: 250px;
		border-radius: 22px;
	}

	figcaption {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.audiences {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem 4rem;
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid color-mix(in srgb, var(--muted) 25%, transparent);
	}

	.audiences h3 {
		font-size: 1.15rem;
	}

	.audiences ul {
		margin: 1rem 0 0;
		padding-left: 1.1rem;
		color: var(--ink-soft);
	}

	.audiences li + li {
		margin-top: 0.4rem;
	}

	.audiences li::marker {
		color: var(--cyan);
	}

	/* Hardware: copy left, photo right, wider */
	.hardware {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}

	.hardware-copy p {
		margin-top: 1.25rem;
		color: var(--ink-soft);
	}

	.hardware-photo {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.75rem;
		font-weight: 600;
		color: var(--link);
		text-decoration: none;
	}

	.text-link :global(svg) {
		width: 1.05em;
		height: 1.05em;
		transition: transform 0.15s;
	}

	.text-link:hover :global(svg) {
		transform: translateX(3px);
	}

	/* Numbers: plain, separated by rules */
	.numbers {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-block: 1px solid var(--line);
	}

	.numbers div {
		padding: 2rem 2rem 2rem 0;
	}

	.numbers div + div {
		padding-left: 2rem;
		border-left: 1px solid var(--line);
	}

	.numbers strong {
		display: block;
		font-size: clamp(2.25rem, 4vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.numbers p {
		margin-top: 0.6rem;
		max-width: 17rem;
		font-size: 0.95rem;
		color: var(--muted);
	}

	/* Open source: full-width photo, then intro and repo list */
	.oss {
		padding-top: clamp(3.5rem, 8vw, 7rem);
	}

	.oss-photo {
		width: 100%;
		height: clamp(240px, 38vw, 460px);
		object-fit: cover;
	}

	.oss-body {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(2rem, 6vw, 5rem);
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.oss-intro p {
		margin: 1.25rem 0 2rem;
		color: var(--ink-soft);
	}

	.repos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--line);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.repos a {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		padding: 1.4rem;
		background: var(--surface);
		text-decoration: none;
		transition: background-color 0.15s;
	}

	.repos a:hover {
		background: var(--page);
	}

	.repos code {
		font-weight: 600;
		font-size: 0.875rem;
	}

	.repos span {
		font-size: 0.95rem;
		color: var(--ink-soft);
	}

	.repos small {
		font-size: 0.8rem;
		color: var(--muted);
	}

	.footer {
		padding-block: 2.5rem 3rem;
		border-top: 1px solid var(--line);
		font-size: 0.9rem;
		color: var(--muted);
	}

	.footer-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		color: var(--ink);
	}

	.footer-top p {
		color: var(--muted);
	}

	.footer nav {
		display: flex;
		gap: 1.5rem;
	}

	.footer nav a {
		text-decoration: none;
	}

	.credits {
		margin-top: 1.5rem;
		font-size: 0.8rem;
	}

	@media (max-width: 960px) {
		.nav nav {
			display: none;
		}
	}

	@media (max-width: 860px) {
		.hero,
		.gate,
		.hardware,
		.oss-body {
			grid-template-columns: 1fr;
		}

		.hero-photo img {
			aspect-ratio: 4 / 3;
		}

		.gate-photo {
			order: 2;
		}

		.app-grid {
			grid-template-columns: 1fr;
		}

		.shot-phone {
			justify-self: center;
		}

		.audiences,
		.repos {
			grid-template-columns: 1fr;
		}

		.numbers {
			grid-template-columns: 1fr;
		}

		.numbers div,
		.numbers div + div {
			padding: 1.5rem 0;
			border-left: none;
		}

		.numbers div + div {
			border-top: 1px solid var(--line);
		}
	}
</style>
